# Vaktkalender settings. Lives on the Pi at ~/.config/vaktkalender/config.env (chmod 600).
# Restart after editing:  systemctl --user restart vaktkalender-web

PUBLIC_URL=https://vakt.example.com
ADMIN_EMAILS=
CONTACT_NAME=
TIMEZONE=Europe/Oslo
CHROMIUM_PATH=/usr/bin/chromium

# RBU's web app and its JSON API. Kept here so they're not in the public code.
RBU_APP_URL=
RBU_API_URL=

# Empty = every team your RBU account can see (new teams are picked up automatically).
# Or a fixed list of RBU org-unit ids, e.g. 101,102,103.
RBU_TEAM_IDS=

# Cloudflare Access: team domain like "yourteam.cloudflareaccess.com",
# and the Application Audience (AUD) tag from the Access application.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

GOOGLE_SERVICE_ACCOUNT_FILE=~/.config/vaktkalender/google-service-account.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shown in Telegram when the RBU login must be renewed
LOGIN_COMMAND="cd ~/path/to/vaktkalender && ./login_rbu.sh"
